<IfModule mod_rewrite.c>
    RewriteEngine On

    # If the requested file exists, serve it directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Redirect React routes to the main index.html
    RewriteRule ^ index.html [L]
</IfModule>